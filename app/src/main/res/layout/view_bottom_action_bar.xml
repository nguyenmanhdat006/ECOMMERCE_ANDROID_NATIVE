<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bar_label"
            style="@style/TextAppearance.App.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/price" />

        <TextView
            android:id="@+id/bar_price"
            style="@style/TextAppearance.App.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bar_secondary"
        style="@style/Widget.App.Button.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginEnd="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/bar_primary"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:background="@drawable/bg_primary_button_ripple"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="140dp"
        android:paddingHorizontal="24dp"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />
</merge>
