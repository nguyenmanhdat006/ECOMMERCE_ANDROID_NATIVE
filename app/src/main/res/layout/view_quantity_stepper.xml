<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageButton
        android:id="@+id/stepper_minus"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_stepper_button"
        android:contentDescription="@string/quantity"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_remove"
        android:tint="@color/text_primary" />

    <TextView
        android:id="@+id/stepper_value"
        style="@style/TextAppearance.App.Heading"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="1" />

    <ImageButton
        android:id="@+id/stepper_plus"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_stepper_button"
        android:contentDescription="@string/quantity"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_add"
        android:tint="@color/primary" />
</merge>
