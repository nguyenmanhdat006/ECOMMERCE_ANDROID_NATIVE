<?xml version="1.0" encoding="utf-8"?>
<!-- Một dòng giỏ hàng: C8 (LineItemView) có ô bên phải chứa nút thùng rác và C9 (QuantityStepper) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_padding"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="12dp">

    <com.example.ecommerce.ui.common.LineItemView
        android:id="@+id/line_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>